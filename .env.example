# Only needed for `npm run census -- --unlock`
# Native Web Unlocker proxy. USER looks like: brd-customer-XXXXX-zone-web_unlocker
BRIGHT_DATA_UNLOCKER_AUTH=
BRIGHT_DATA_UNLOCKER_PROXY_HOST=brd.superproxy.io
BRIGHT_DATA_UNLOCKER_PROXY_PORT=44445
# 1 = skip TLS verify on the proxy hop (Bright Data's default Node snippet).
# Install their CA and set 0 if you want verify on.
BRIGHT_DATA_UNLOCKER_INSECURE=1
